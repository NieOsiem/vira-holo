<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    <legend>{{localize "VIRAHOLO.Config.Annotations"}}</legend>
    <div class="form-group">
      <label for="{{partId}}-label-mode">{{localize "VIRAHOLO.Config.look.labelMode"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-label-mode" name="{{labelModeField}}">
          {{selectOptions labelModes selected=holo.look.labelMode}}
        </select>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.look.labelModeHint"}}</p>
    </div>
    {{#each markingSliders}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <range-picker name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"></range-picker>
      </div>
    </div>
    {{/each}}
    <div class="form-group">
      <label for="{{partId}}-label-font">{{localize "VIRAHOLO.Config.look.labelFont"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-label-font" name="{{labelFontField}}">
          {{selectOptions labelFonts selected=holo.look.labelFont}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-pin-lean">{{localize "VIRAHOLO.Config.look.pinLean"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-pin-lean" name="{{pinLeanField}}" {{checked holo.look.pinLean}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.look.pinLeanHint"}}</p>
    </div>
    {{#if holo.map.uuid}}
    <div class="form-group">
      <label for="{{partId}}-own-markings">{{localize "VIRAHOLO.Maps.OwnMarkings"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-own-markings" name="{{flags}}.map.ownMarkings" {{checked holo.map.markings}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Maps.OwnMarkingsHint"}}</p>
    </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.markerCount"}}</label>
      <div class="form-fields">
        <span class="vira-holo-count">{{markerCount}}</span>
        <button type="button" data-action="clearMarkers" {{disabled (not markerCount)}}>
          <i class="fa-solid fa-trash" inert></i> {{localize "VIRAHOLO.Config.clearMarkers"}}
        </button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.markersHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.strokeCount"}}</label>
      <div class="form-fields">
        <span class="vira-holo-count">{{strokeCount}}</span>
        <button type="button" data-action="clearStrokes" {{disabled (not strokeCount)}}>
          <i class="fa-solid fa-trash" inert></i> {{localize "VIRAHOLO.Config.clearStrokes"}}
        </button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.strokesHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.measureCount"}}</label>
      <div class="form-fields">
        <span class="vira-holo-count">{{measureCount}}</span>
        <button type="button" data-action="clearMeasures" {{disabled (not measureCount)}}>
          <i class="fa-solid fa-trash" inert></i> {{localize "VIRAHOLO.Config.clearMeasures"}}
        </button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.measuresHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.areaCount"}}</label>
      <div class="form-fields">
        <span class="vira-holo-count">{{areaCount}}</span>
        <button type="button" data-action="clearAreas" {{disabled (not areaCount)}}>
          <i class="fa-solid fa-trash" inert></i> {{localize "VIRAHOLO.Config.clearAreas"}}
        </button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.areasHint"}}</p>
    </div>
  </fieldset>
</section>
