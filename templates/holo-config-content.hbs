<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    <legend>{{localize "VIRAHOLO.Config.General"}}</legend>
    <div class="form-group">
      <label for="{{partId}}-enabled">{{localize "VIRAHOLO.Config.enabled"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-enabled" name="{{flags}}.enabled" {{checked holo.enabled}}>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-mode">{{localize "VIRAHOLO.Config.mode"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-mode" name="{{flags}}.mode">{{selectOptions modes selected=holo.mode}}</select>
      </div>
    </div>
    {{#unless isText}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.image"}}</label>
      <div class="form-fields">
        <file-picker name="{{flags}}.image" type="imagevideo" value="{{holo.image}}"></file-picker>
      </div>
    </div>
    {{/unless}}
  </fieldset>

  {{#unless isText}}
  <fieldset>
    <legend>{{localize "VIRAHOLO.Config.scale.legend"}}</legend>
    <div class="form-group">
      <label for="{{partId}}-scale">{{localize "VIRAHOLO.Config.scale.covers"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-scale" name="{{flags}}.scale.distance" value="{{holo.scale.distance}}" min="0" step="any">
        <select name="{{flags}}.scale.unit" aria-label="{{localize "VIRAHOLO.Config.scale.unit"}}">{{selectOptions units selected=holo.scale.unit}}</select>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-axis">{{localize "VIRAHOLO.Config.scale.across"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-axis" name="{{flags}}.scale.axis">{{selectOptions axes selected=holo.scale.axis}}</select>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.scale.hint"}}</p>
    </div>
  </fieldset>
  {{/unless}}

  {{#if isTerrain}}
  <fieldset>
    <legend>{{localize "VIRAHOLO.Mode.terrain"}}</legend>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.terrain.heightmap"}}</label>
      <div class="form-fields">
        <file-picker name="{{flags}}.terrain.heightmap" type="image" value="{{holo.terrain.heightmap}}"></file-picker>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.terrain.heightmapHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-display">{{localize "VIRAHOLO.Config.terrain.display"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-display" name="{{flags}}.terrain.display">{{selectOptions displayModes selected=holo.terrain.display}}</select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.terrain.disabled"}}</label>
      <div class="form-fields">
        {{#each displayToggles}}
        <label class="checkbox"><input type="checkbox" name="{{name}}" {{checked disabled}}> {{label}}</label>
        {{/each}}
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.terrain.disabledHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-grid">{{localize "VIRAHOLO.Config.terrain.grid"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-grid" name="{{flags}}.terrain.grid" value="{{holo.terrain.grid}}" min="0" step="any">
        <span>{{gridUnit}}</span>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.terrain.gridHint"}}</p>
    </div>
    {{#each terrainSliders}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <range-picker name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"></range-picker>
      </div>
    </div>
    {{/each}}
  </fieldset>
  {{/if}}

  {{#if isText}}
  <fieldset>
    <legend>{{localize "VIRAHOLO.Mode.text"}}</legend>
    <div class="form-group">
      <label for="{{partId}}-source">{{localize "VIRAHOLO.Config.text.source"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-source" name="{{flags}}.text.source">{{selectOptions signSources selected=holo.text.source}}</select>
      </div>
    </div>
    {{#if fromJournal}}
    <div class="form-group">
      <label for="{{partId}}-journal">{{localize "VIRAHOLO.Config.text.journal"}}</label>
      <div class="form-fields">
        <input type="text" id="{{partId}}-journal" name="{{flags}}.text.journal" value="{{holo.text.journal}}" placeholder="JournalEntry.…">
      </div>
      <p class="hint">{{#if journalName}}<strong>{{journalName}}</strong> — {{/if}}{{localize "VIRAHOLO.Config.text.journalHint"}}</p>
    </div>
    {{else}}
    <div class="form-group stacked">
      <label for="{{partId}}-content">{{localize "VIRAHOLO.Config.text.content"}}</label>
      <textarea id="{{partId}}-content" name="{{flags}}.text.content" rows="6">{{holo.text.content}}</textarea>
      <p class="hint">{{localize "VIRAHOLO.Config.text.contentHint"}}</p>
      <button type="button" data-action="insertImage">
        <i class="fa-solid fa-image" inert></i> {{localize "VIRAHOLO.Config.text.insertImage"}}
      </button>
    </div>
    {{/if}}
    <div class="form-group">
      <label for="{{partId}}-font">{{localize "VIRAHOLO.Config.text.font"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-font" name="{{flags}}.text.font">{{selectOptions fonts selected=holo.text.font}}</select>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-size">{{localize "VIRAHOLO.Config.text.size"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-size" name="{{flags}}.text.size" value="{{holo.text.size}}" min="6" step="1">
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.text.sizeHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-align">{{localize "VIRAHOLO.Config.text.align"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-align" name="{{flags}}.text.align">{{selectOptions aligns selected=holo.text.align}}</select>
      </div>
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "VIRAHOLO.Config.text.sign"}}</legend>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.text.tilt"}}</label>
      <div class="form-fields">
        <range-picker name="{{flags}}.text.tilt" value="{{holo.text.tilt}}" min="{{tiltRange.[0]}}" max="{{tiltRange.[1]}}" step="1"></range-picker>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.text.tiltHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-panel">{{localize "VIRAHOLO.Config.text.panel"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-panel" name="{{flags}}.text.panel">{{selectOptions signPanels selected=holo.text.panel}}</select>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-base">{{localize "VIRAHOLO.Config.text.base"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-base" name="{{flags}}.text.base">{{selectOptions signBases selected=holo.text.base}}</select>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-scroll">{{localize "VIRAHOLO.Config.text.scroll"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-scroll" name="{{flags}}.text.scroll">{{selectOptions signScrolls selected=holo.text.scroll}}</select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.text.speed"}}</label>
      <div class="form-fields">
        <range-picker name="{{flags}}.text.speed" value="{{holo.text.speed}}" min="0.25" max="4" step="0.25"></range-picker>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-paging">{{localize "VIRAHOLO.Config.text.paging"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-paging" name="{{flags}}.text.paging">{{selectOptions signPagings selected=holo.text.paging}}</select>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.text.pagingHint"}}</p>
    </div>
    {{#if manualPaging}}
    <div class="form-group">
      <label for="{{partId}}-flip-all">{{localize "VIRAHOLO.Config.text.flipAll"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-flip-all" name="{{flags}}.text.flipAll" {{checked holo.text.flipAll}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.text.flipAllHint"}}</p>
    </div>
    {{else}}
    <div class="form-group">
      <label for="{{partId}}-interval">{{localize "VIRAHOLO.Config.text.interval"}}</label>
      <div class="form-fields">
        <input type="number" id="{{partId}}-interval" name="{{flags}}.text.interval" value="{{holo.text.interval}}" min="2" max="600" step="1">
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.text.intervalHint"}}</p>
    </div>
    {{/if}}
  </fieldset>
  {{/if}}
</section>
