<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    {{#if holo.link}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Link.LinkedTo"}}</label>
      <div class="form-fields">
        <a class="vira-holo-link-name" data-action="openLink"><i class="fa-solid fa-link" inert></i> {{holo.link.name}}</a>
        <button type="button" data-action="leaveLink"><i class="fa-solid fa-link-slash" inert></i> {{localize "VIRAHOLO.Link.Leave"}}</button>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Link.Shares"}}</label>
      <div class="form-fields vira-holo-share">
        {{#each shareOptions}}
        <label class="checkbox"><input type="checkbox" name="{{@root.flags}}.link.share.{{section}}" {{checked checked}}> {{label}}</label>
        {{/each}}
      </div>
      <p class="hint">{{localize "VIRAHOLO.Link.SharesHint"}}</p>
    </div>
    {{else}}
    {{#if holo.linkMissing}}<p class="hint vira-holo-warning">{{localize "VIRAHOLO.Link.Missing"}}</p>{{/if}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Link.Join"}}</label>
      <div class="form-fields">
        <select data-link-choice aria-label="{{localize "VIRAHOLO.Link.Join"}}">{{selectOptions linkChoices}}</select>
        <button type="button" data-action="joinLink" {{disabled (not hasLinks)}}>{{localize "VIRAHOLO.Link.JoinButton"}}</button>
      </div>
    </div>
    <div class="form-group">
      <label></label>
      <div class="form-fields">
        <button type="button" data-action="createLink"><i class="fa-solid fa-link" inert></i> {{localize "VIRAHOLO.Link.Create"}}</button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Link.Hint"}}</p>
    </div>
    {{/if}}
  </fieldset>
</section>
