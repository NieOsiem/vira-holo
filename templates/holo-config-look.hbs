<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    {{#if awayFromHome}}
    <div class="form-group">
      <label for="{{partId}}-own-look">{{localize "VIRAHOLO.Maps.OwnLook"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-own-look" name="{{flags}}.map.ownLook" {{checked holo.map.ownLook}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Maps.OwnLookHint"}}</p>
    </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.look.color"}}</label>
      <div class="form-fields">
        <color-picker name="{{flags}}.look.color" value="{{holo.look.color}}"></color-picker>
      </div>
    </div>
    {{#each lookSliders}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <range-picker name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"></range-picker>
      </div>
    </div>
    {{/each}}
    <div class="form-group">
      <label for="{{partId}}-ring">{{localize "VIRAHOLO.Config.look.ring"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-ring" name="{{flags}}.look.ring" {{checked holo.look.ring}}>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-dashes">{{localize "VIRAHOLO.Config.look.dashes"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-dashes" name="{{flags}}.look.dashes" {{checked holo.look.dashes}}>
      </div>
    </div>
    <div class="form-group">
      <label for="{{partId}}-north">{{localize "VIRAHOLO.Config.look.north"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-north" name="{{flags}}.look.north" {{checked holo.look.north}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.look.northHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{partId}}-glow">{{localize "VIRAHOLO.Config.look.glow"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-glow" name="{{flags}}.look.glow" {{checked holo.look.glow}}>
      </div>
    </div>
  </fieldset>
</section>
