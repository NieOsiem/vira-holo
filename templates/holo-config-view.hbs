<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    <div class="form-group">
      <label for="{{partId}}-interactive">{{localize "VIRAHOLO.Config.interactive"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{partId}}-interactive" name="{{flags}}.interactive" {{checked holo.interactive}}>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.interactiveHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.owners"}}</label>
      <div class="form-fields">
        {{#if players.length}}
        <multi-checkbox name="{{flags}}.owners">
          {{#each players}}<option value="{{id}}" {{#if owner}}selected{{/if}}>{{name}}</option>{{/each}}
        </multi-checkbox>
        {{else}}
        <span class="hint">{{localize "VIRAHOLO.Config.noPlayers"}}</span>
        {{/if}}
      </div>
      <p class="hint">{{localize "VIRAHOLO.Config.ownersHint"}}</p>
    </div>
    {{#each cameraSliders}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <range-picker name="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}" step="{{step}}"></range-picker>
      </div>
    </div>
    {{/each}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Config.view"}}</label>
      <div class="form-fields">
        <button type="button" data-action="resetView">
          <i class="fa-solid fa-crosshairs" inert></i> {{localize "VIRAHOLO.Config.resetView"}}
        </button>
      </div>
    </div>
  </fieldset>
</section>
