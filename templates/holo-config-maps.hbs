<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <fieldset>
    {{#if holo.map.uuid}}
    <div class="form-group">
      <label for="{{partId}}-name">{{localize "VIRAHOLO.Maps.Name"}}</label>
      <div class="form-fields">
        <input type="text" id="{{partId}}-name" name="{{flags}}.map.name" value="{{holo.map.name}}">
      </div>
      {{#unless holo.map.home}}<p class="hint">{{localize "VIRAHOLO.Maps.AwayHint"}}</p>{{/unless}}
    </div>
    <div class="form-group">
      <label for="{{partId}}-parent">{{localize "VIRAHOLO.Maps.Parent"}}</label>
      <div class="form-fields">
        <select id="{{partId}}-parent" name="{{flags}}.map.parentUuid">
          {{selectOptions parentChoices selected=holo.map.parent.uuid blank=(localize "VIRAHOLO.Maps.NoParent")}}
        </select>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Maps.ParentHint"}}</p>
    </div>
    {{else}}
    <p class="hint">{{localize "VIRAHOLO.Maps.NotAMap"}}</p>
    {{/if}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Maps.Add"}}</label>
      <div class="form-fields">
        <button type="button" data-action="addMapAbove"><i class="fa-solid fa-arrow-up" inert></i> {{localize "VIRAHOLO.Maps.AddAbove"}}</button>
        <button type="button" data-action="addMapInside"><i class="fa-solid fa-arrow-down" inert></i> {{localize "VIRAHOLO.Maps.AddInside"}}</button>
      </div>
      <p class="hint">{{localize "VIRAHOLO.Maps.AddHint"}}</p>
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "VIRAHOLO.Maps.Travel"}}</legend>
    {{#if holo.map.parent}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Maps.Up"}}</label>
      <div class="form-fields">
        <button type="button" data-action="travel" data-uuid="{{holo.map.parent.uuid}}"><i class="fa-solid fa-arrow-up" inert></i> {{holo.map.parent.name}}</button>
      </div>
    </div>
    {{/if}}
    {{#if mapChildren.length}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Maps.Children"}}</label>
      <div class="form-fields vira-holo-share">
        {{#each mapChildren}}
        <button type="button" data-action="travel" data-uuid="{{uuid}}"><i class="fa-solid fa-right-to-bracket" inert></i> {{name}}</button>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{#unless holo.map.home}}
    <div class="form-group">
      <label>{{localize "VIRAHOLO.Maps.Home"}}</label>
      <div class="form-fields">
        <button type="button" data-action="goHome"><i class="fa-solid fa-house" inert></i> {{localize "VIRAHOLO.Maps.GoHome"}}</button>
      </div>
    </div>
    {{/unless}}
    <p class="hint">{{localize "VIRAHOLO.Maps.TravelHint"}}</p>
  </fieldset>
</section>
